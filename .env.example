# ============================================================================
# mygarmin - example environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ============================================================================

# --- Garmin Personal API ---------------------------------------------------
# Your personal API key from https://connect.garmin.com (Account > Personal API Key).
# The key is shown ONCE at creation. If you lose it, delete & create a new one.
# Keys expire after 30/90/180 days or 1 year (your choice at creation time).
#
# Provide the key EITHER inline here, OR via a file (recommended if you keep the
# key in a file such as ./garmin_access.key). If both are set, the inline value
# below wins. Leave this blank to use the key file instead.
GARMIN_PERSONAL_API_KEY=

# Path to a file containing ONLY the API key (whitespace/newlines are trimmed).
# Relative paths resolve against the project root. This file must NOT be committed
# (*.key is git-ignored). Example: a key saved at the repo root as garmin_access.key
GARMIN_PERSONAL_API_KEY_FILE=./garmin_access.key

# Token service endpoint (documented). Change only if Garmin updates it.
GARMIN_TOKEN_URL=https://personal.connectapi.garmin.com/personalapitoken-service/personal-api/personal-api-key/token

# Base URL for Personal API data resources.
# The Personal API wraps Garmin's Health/Activity REST services. The resource
# paths below default to the documented wellness-api model; adjust them to match
# your account's live Swagger (developer.garmin.com Personal API Swagger) if needed.
GARMIN_API_BASE_URL=https://personal.connectapi.garmin.com

# Resource path templates (relative to GARMIN_API_BASE_URL), matching the real
# Personal API Swagger. Placeholders: {date}, {fromDate}, {toDate}, {activityId}
# (yyyy-mm-dd). Override only if Garmin changes a route. You normally should NOT
# need to touch these.
GARMIN_PATH_DAILY=/usersummary-service/usersummary/daily
GARMIN_PATH_SLEEP=/sleep-service/sleep/dailySleep
GARMIN_PATH_HRV=/hrv-service/hrv/{date}
GARMIN_PATH_HRV_RANGE=/hrv-service/hrv/daily/{fromDate}/{toDate}
GARMIN_PATH_STRESS_RANGE=/usersummary-service/stats/stress/daily/{fromDate}/{toDate}
GARMIN_PATH_STEPS_RANGE=/usersummary-service/stats/steps/daily/{fromDate}/{toDate}
GARMIN_PATH_BODY_BATTERY=/wellness-service/wellness/bodyBattery/reports/daily
GARMIN_PATH_DAILY_HEART_RATE=/wellness-service/wellness/dailyHeartRate
GARMIN_PATH_ACTIVITIES_SEARCH=/activitylist-service/activities/search/activities
GARMIN_PATH_ACTIVITY_DETAIL=/activity-service/activity/{activityId}
GARMIN_PATH_ACTIVITY_FILE=/download-service/files/activity/{activityId}
GARMIN_PATH_USERPROFILE_SETTINGS=/userprofile-service/userprofile/settings

# --- Application -----------------------------------------------------------
# SQLite database file (relative to project root or absolute).
DATABASE_PATH=./data/mygarmin.db

# Where raw API payloads and downloaded .FIT files are archived.
RAW_PAYLOAD_DIR=./data/raw_payloads
FIT_FILE_DIR=./data/fit_files

# Server bind. Keep 127.0.0.1 for localhost-only (recommended for self-hosting).
# Use 0.0.0.0 ONLY if you intentionally expose on your LAN (see docs/SECURITY.md).
HOST=127.0.0.1
PORT=8787

# OPTIONAL. If set, POST /api/sync requires "Authorization: Bearer <token>".
# Leave blank for localhost-only use; set it before exposing the app on a network.
# Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
SYNC_API_TOKEN=

# Display timezone for local-time rendering (IANA name). Finnish default.
DISPLAY_TIMEZONE=Europe/Helsinki

# Default unit system for presentation: metric or imperial.
UNIT_SYSTEM=metric

# Runtime mode: production or development.
# In `development`, mock fixtures may be loaded (clearly labelled). In `production`,
# mock data is NEVER shown.
APP_ENV=production

# How many days of history to pull on the first (initial) sync.
INITIAL_IMPORT_DAYS=90

# Background sync inside the web server, in minutes. 0 disables it. Default 60.
# Do not run `python -m app.scheduler` as well unless you disable this (see docs/OPERATIONS.md).
AUTO_SYNC_MINUTES=60

# Pause (seconds) between per-day Garmin calls, to avoid HTTP 429.
SYNC_DAY_DELAY_SECONDS=0.2

# Optional: comma-separated CORS origins for the frontend dev server.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
