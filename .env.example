# ============================================================================
# mygarmin - example environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ============================================================================

# --- Garmin Personal API ---------------------------------------------------
# Your personal API key from https://connect.garmin.com (Account > Personal API Key).
# The key is shown ONCE at creation. If you lose it, delete & create a new one.
# Keys expire after 30/90/180 days or 1 year (your choice at creation time).
# If unset, the backend reads the raw key from garmin_accesss.key (or
# garmin_access.key for existing setups). Override with GARMIN_PERSONAL_API_KEY_FILE.
GARMIN_PERSONAL_API_KEY=replace-with-your-personal-api-key

# Token service endpoint (documented). Change only if Garmin updates it.
GARMIN_TOKEN_URL=https://personal.connectapi.garmin.com/personalapitoken-service/personal-api/personal-api-key/token

# Base URL for Personal API data resources.
# The Personal API wraps Garmin's Health/Activity REST services. The resource
# paths below default to the documented wellness-api model; adjust them to match
# your account's live Swagger (developer.garmin.com Personal API Swagger) if needed.
GARMIN_API_BASE_URL=https://personal.connectapi.garmin.com

# Resource paths from the Garmin Connect Personal API Swagger. Date ranges are
# added by the client using the endpoint-specific date parameters/path segments.
GARMIN_PATH_DAILIES=/usersummary-service/v2/dailysummaries
GARMIN_PATH_SLEEPS=/sleep-service/sleep/dailySleepSummariesByDate
GARMIN_PATH_STRESS=/usersummary-service/stats/stress/daily
GARMIN_PATH_HRV=/hrv-service/hrv/daily
GARMIN_PATH_RESPIRATION=/wellness-api/rest/respiration
GARMIN_PATH_PULSEOX=/wellness-api/rest/pulseOx
GARMIN_PATH_ACTIVITIES=/activitylist-service/activities/search/activities
GARMIN_PATH_ACTIVITY_DETAILS=/wellness-api/rest/activityDetails
GARMIN_PATH_ACTIVITY_FILE=/wellness-api/rest/activityFile

# --- Application -----------------------------------------------------------
# SQLite database file (relative to project root or absolute).
DATABASE_PATH=./data/mygarmin.db

# Where raw API payloads and downloaded .FIT files are archived.
RAW_PAYLOAD_DIR=./data/raw_payloads
FIT_FILE_DIR=./data/fit_files

# Server bind. Keep 127.0.0.1 for localhost-only (recommended for self-hosting).
# Use 0.0.0.0 ONLY if you intentionally expose on your LAN (see docs/SECURITY.md).
HOST=127.0.0.1
PORT=8787

# Optional bearer token to protect sync / mutating admin operations via the HTTP API.
# Generate a long random value, e.g.: python -c "import secrets;print(secrets.token_urlsafe(32))"
# Leave blank to allow sync without a token (appropriate only for trusted networks).
SYNC_API_TOKEN=

# Display timezone for local-time rendering (IANA name). Finnish default.
DISPLAY_TIMEZONE=Europe/Helsinki

# Default unit system for presentation: metric or imperial.
UNIT_SYSTEM=metric

# Runtime mode: production or development.
# In `development`, mock fixtures may be loaded (clearly labelled). In `production`,
# mock data is NEVER shown.
APP_ENV=production

# How many days of history to pull on the first (initial) sync.
INITIAL_IMPORT_DAYS=90

# Max days per API request window (stress and sleep endpoints cap ranges).
SYNC_WINDOW_DAYS=27

# Optional: comma-separated CORS origins for the frontend dev server.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
